{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix frontend/workspace --no-audit --no-fund",
  "buildCommand": "npm run build --prefix frontend/workspace",
  "outputDirectory": "frontend/workspace/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://3-113-242-142.sslip.io/api/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
      { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
    ] }
  ]
}
