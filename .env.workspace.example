# Local workspace: independent of the private dashboard on 8080.
ZEUS_WORKSPACE_HOST=127.0.0.1
ZEUS_WORKSPACE_PORT=8081
ZEUS_WORKSPACE_ORIGIN=http://127.0.0.1:8081

# Optional public Reown project identifier for WalletConnect/mobile QR.
# Installed EVM wallets work without this value.
ZEUS_WALLETCONNECT_PROJECT_ID=

# Production only: set all three, behind an HTTPS reverse proxy.
# ZEUS_WORKSPACE_PRODUCTION=1
# ZEUS_WORKSPACE_ORIGIN=https://your-zeus-domain.example
# ZEUS_WORKSPACE_DATABASE_URL=postgresql+psycopg://user:password@host/zeus
# ZEUS_WORKSPACE_KEY=<Fernet key managed outside the database>
