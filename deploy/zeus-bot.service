[Unit]
Description=Zeus Hyperliquid bot server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/zeusproject
EnvironmentFile=/home/ec2-user/zeusproject/.env
ExecStart=/home/ec2-user/zeusproject/.venv/bin/python /home/ec2-user/zeusproject/bot_server.py
Restart=always
RestartSec=5
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
